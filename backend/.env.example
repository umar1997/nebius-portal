PORT=3001
DB_PATH=./data/apps.db
SOCKS_PROXY=socks5h://localhost:1080
ALLOWED_HOSTS=worker-0,worker-1,worker-2,worker-3,worker-4,worker-5,worker-6,worker-7

# JWT — generate each with: openssl rand -hex 32
JWT_SECRET=<replace>
JWT_REFRESH_SECRET=<replace>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Superadmin — never stored in DB
ADMIN_EMAIL=<your admin email>
# Generate: node -e "require('bcrypt').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=<replace>
